# ─────────────────────────────────────────────────────────────
# Ghost Post Autopilot — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
# Anthropic API key (Claude Console → API keys). You can instead paste it in the app:
# Admin → App settings → Integrations (stored encrypted). A key saved in the app takes priority.
ANTHROPIC_API_KEY=
# Only for personal/service-account keys that aren't tied to one workspace (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
# Model used for all generation. Any current Claude model ID works.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: the app's own Google Gemini key (aistudio.google.com/apikey, from a project with billing on). Free-trial accounts
# write with it, and it steps in when Claude can't answer. Can also be pasted in Admin → App settings → Integrations.
GEMINI_API_KEY=
# Optional: Replicate API token (r8_…) adds Seedance 2.5 and the open-weight Wan 2.2 as engines for animated Movie Studio scenes.
REPLICATE_API_TOKEN=
GEMINI_MODEL=gemini-3.8-flash
# Movie Studio (characters, AI pictures and Veo clips) runs on the same Gemini key. Defaults: Nano Banana 2.1 pictures
# ($0.0504 per 2K picture) and Veo 3.1 Fast ($0.10 per second at 720p), falling back to gemini-3.1-flash-image and
# veo-3.1-generate-preview. Override with any model ID from ai.google.dev → Models. Billing must be on for the key's project.
GEMINI_IMAGE_MODEL=
VEO_MODEL=
# Optional: stronger model for long story scripts on the Unlimited plan (costs 2x credits).
ANTHROPIC_PREMIUM_MODEL=claude-opus-5-5

# 32+ random bytes used to encrypt platform tokens at rest.
# Generate with:  npm run gen:key
ENCRYPTION_KEY=

# Accounts: the FIRST person to sign up becomes the admin. You can also list admin emails here
# (comma-separated); those addresses always get admin access and the Unlimited plan.
ADMIN_EMAILS=
# Secret phrase required to create the first (owner/admin) account on a public server.
SETUP_CODE=
# Shown on /terms, /privacy and /data-deletion when not set in Admin → App settings.
SUPPORT_EMAIL=
LEGAL_NAME=
LEGAL_JURISDICTION=

# Shared secret for the scheduler endpoints (/api/cron/*).
# Your cron caller must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Payments: Stripe Billing (optional until you charge) ─────
# Easiest: leave these blank and use Admin → App settings → Integrations → "Connect Stripe & create plans".
# It creates the products, prices, webhook and customer portal for you. Values below are defaults;
# whatever "Connect Stripe" saves takes priority.
# Stripe Dashboard → Developers → API keys. Use test keys (sk_test_…) until you're ready.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → add endpoint {APP_URL}/api/stripe/webhook with events:
# checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Create a Product per paid plan with a monthly and a yearly recurring Price; paste the price IDs (price_…).
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_ANNUAL=
# Optional: a specific Customer Portal configuration (bpc_…)
STRIPE_PORTAL_CONFIGURATION=

# ── Email (optional): "Forgot password?" links via Resend (HTTPS API) ──
# Email goes over HTTPS. Verify your domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=            # e.g. Ghost Post <support@yourdomain.com>

# ── Storage (optional) ──────────────────────────────────────
# Leave blank to use a local JSON file + ./.data/uploads (fine for local / one server).
# Set both to use Supabase database + Storage (required on serverless hosts like Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Account linking ("Connect with …" buttons) ───────────────
# Register an app on each platform and add this redirect URL to it:
#   {APP_URL}/api/connect/{platform}/callback
#   e.g. https://your-domain.com/api/connect/x/callback
# Leave a pair blank to hide that platform's Connect button (manual token entry still works).

# X — developer.x.com → your app → User authentication: OAuth 2.0, type "Web App"
X_CLIENT_ID=
X_CLIENT_SECRET=

# Facebook Pages — developers.facebook.com → app (type Business) → add "Facebook Login for Business"
# Posts go to Pages you manage; apps can't post to personal profiles.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# LinkedIn — linkedin.com/developers → add products "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram — developers.facebook.com → app with "Instagram API with Instagram Login" (Business/Creator accounts)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube — console.cloud.google.com → OAuth client (Web application), YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok — developers.tiktok.com → app with Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API host/version. graph.instagram.com matches "Instagram Login" above.
META_GRAPH_VERSION=v23.0
META_GRAPH_HOST=graph.instagram.com

# LinkedIn REST API version (YYYYMM). Leave blank to auto-use a recent version.
LINKEDIN_API_VERSION=

# ── Worker (self-hosting only) ──────────────────────────────
# Public URL of this app. Used for account-linking redirect URLs and by `npm run worker`.
APP_URL=http://localhost:3000
WORKER_INTERVAL_MINUTES=5

# ── Video rendering & upload ─────────────────────────────────────────────
# The server needs ffmpeg (deploy/azure-app/install.sh installs it).
# AI voiceover for rendered videos (optional — without it videos are captions-only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # optional; defaults to a premade narrator voice
# Stock footage matched to each scene (optional). Pixabay is used first (free key: pixabay.com/api/docs),
# Pexels second (pexels.com/api). Both can also be added in Admin → App settings → Integrations.
PIXABAY_API_KEY=
PEXELS_API_KEY=
# YouTube uploads: public | unlisted | private (default public)
YOUTUBE_PRIVACY=public
